---
import '@/styles/global.css';
import { withBase } from '@/lib/links';

export type Section = 'home' | 'exams' | 'universities' | 'programs' | null;

interface Props {
  title: string;
  description: string;
  section: Section;
}
const { title, description, section } = Astro.props;
const fullTitle = section === 'home' ? title : `${title} — Global Admission`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav: [Exclude<Section, null>, string, string][] = [
  ['home', '', 'Главная'],
  ['exams', 'exams/', 'Экзамены'],
  ['universities', 'universities/', 'Университеты'],
  ['programs', 'programs/', 'Таблица направлений'],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="theme-color" content="#fbfbf8" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={withBase()} aria-label="Global Admission — на главную">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20.5 4.2c8.6.2 15.6 7 15.3 15.7-.3 8.7-7.4 15.6-16 15.5C11.2 35.2 4.4 28.3 4.6 19.8 4.8 12 10.6 5.6 18.2 4.6" fill="none" stroke="#d3343e" stroke-width="2.2" stroke-linecap="round"></path><text x="20" y="25.5" text-anchor="middle" font-family="Unbounded,system-ui" font-weight="800" font-size="13" fill="#2141b0" letter-spacing="-.5">GA</text></svg>
          <span>Global Admission</span>
        </a>
        <nav aria-label="Разделы">
          {nav.map(([key, path, label]) => (
            <a href={withBase(path)} class={key === section ? 'active' : undefined} aria-current={key === section ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <div>
          <span class="who">Global Admission · Автор проекта: Король Иван</span>
          <small class="muted">Независимый справочник. Не связан с организаторами экзаменов или университетами.</small>
        </div>
        <a href="#main">Наверх</a>
      </div>
    </footer>
  </body>
</html>
