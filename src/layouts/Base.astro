---
import '@/styles/global.css';
import { withBase } from '@/lib/links';

export type Section = 'home' | 'exams' | 'universities' | 'programs' | 'my' | null;

interface Props {
  title: string;
  description: string;
  section: Section;
}
const { title, description, section } = Astro.props;
const fullTitle = section === 'home' ? title : `${title} — Global Admission`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav: [Exclude<Section, null>, string, string][] = [
  ['home', '', 'Главная'],
  ['exams', 'exams/', 'Экзамены'],
  ['universities', 'universities/', 'Университеты'],
  ['programs', 'programs/', 'Таблица направлений'],
  ['my', 'my/', 'Мой список'],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="theme-color" content="#fbfbf8" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={withBase()} aria-label="Global Admission — на главную">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20.5 4.2c8.6.2 15.6 7 15.3 15.7-.3 8.7-7.4 15.6-16 15.5C11.2 35.2 4.4 28.3 4.6 19.8 4.8 12 10.6 5.6 18.2 4.6" fill="none" stroke="#d3343e" stroke-width="2.2" stroke-linecap="round"></path><text x="20" y="25.5" text-anchor="middle" font-family="Unbounded,system-ui" font-weight="800" font-size="13" fill="#2141b0" letter-spacing="-.5">GA</text></svg>
          <span>Global Admission</span>
        </a>
        <nav aria-label="Разделы">
          {nav.map(([key, path, label]) => (
            <a href={withBase(path)} class={key === section ? 'active' : undefined} aria-current={key === section ? 'page' : undefined}>{label}{key === 'my' && <span class="badge" data-shortlist-count hidden></span>}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <div>
          <span class="who">Global Admission · Автор проекта: Король Иван</span>
          <small class="muted">Независимый справочник. Не связан с организаторами экзаменов или университетами.</small>
        </div>
        <a href="#main">Наверх</a>
      </div>
    </footer>
    <p class="toast" id="toast" role="status" aria-live="polite" hidden></p>
  </body>
</html>

<script>
  // Bookmark buttons on every page, and the «Мой список» counter in the header.
  import { load, save, toggle } from '@/lib/shortlist';

  const toast = document.querySelector<HTMLElement>('#toast')!;
  let timer = 0;
  const say = (text: string) => {
    toast.textContent = text;
    toast.hidden = false;
    clearTimeout(timer);
    timer = window.setTimeout(() => (toast.hidden = true), 2600);
  };

  function paint() {
    const list = load();
    const n = Object.keys(list).length;
    for (const badge of document.querySelectorAll<HTMLElement>('[data-shortlist-count]')) {
      badge.textContent = String(n);
      badge.hidden = n === 0;
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-save]')) {
      const on = Boolean(list[b.dataset.save!]);
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', `${on ? 'Убрать' : 'Добавить'} ${b.dataset.name} ${on ? 'из моего списка' : 'в мой список'}`);
      const label = b.querySelector('[data-save-label]');
      if (label) label.textContent = on ? 'В моём списке' : 'В мой список';
    }
  }

  document.addEventListener('click', (ev) => {
    const b = (ev.target as Element).closest<HTMLButtonElement>('[data-save]');
    if (!b) return;
    ev.preventDefault();
    const next = toggle(load(), b.dataset.save!);
    const added = Boolean(next[b.dataset.save!]);
    if (!save(next)) return say('Браузер не разрешил сохранить список: проверь, не включён ли приватный режим.');
    say(added ? `${b.dataset.name} — в твоём списке` : `${b.dataset.name} убран из списка`);
  });
  window.addEventListener('shortlist-change', paint);
  window.addEventListener('storage', paint);
  paint();
</script>
