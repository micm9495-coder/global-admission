---
/**
 * Notebook-style tabs. Each panel is a named slot whose name matches a tab id.
 * Without JavaScript every panel stays visible, one under another.
 */
interface Props {
  tabs: { id: string; label: string }[];
}
const { tabs } = Astro.props;
---
<div class="tabset" data-tabs>
  <div class="tabs" role="tablist">
    {tabs.map((t, k) => (
      <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={k === 0 ? 'true' : 'false'} class={k === 0 ? 'active' : undefined} tabindex={k === 0 ? 0 : -1} data-tab={t.id}>{t.label}</button>
    ))}
  </div>
  {tabs.map((t) => (
    <section class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0">
      <slot name={t.id} />
    </section>
  ))}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];

    const select = (id: string, focus = false) => {
      for (const b of buttons) {
        const on = b.dataset.tab === id;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      }
      for (const p of panels) p.hidden = p.id !== `panel-${id}`;
    };

    root.querySelector('[role=tablist]')!.addEventListener('click', (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[role=tab]');
      if (!b?.dataset.tab) return;
      select(b.dataset.tab);
      history.replaceState(null, '', `#${b.dataset.tab}`);
    });
    root.querySelector('[role=tablist]')!.addEventListener('keydown', (ev) => {
      const e = ev as KeyboardEvent;
      const k = buttons.findIndex((b) => b.classList.contains('active'));
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = buttons[(k + step + buttons.length) % buttons.length]!;
      select(next.dataset.tab!, true);
    });

    const fromHash = location.hash.slice(1);
    select(buttons.some((b) => b.dataset.tab === fromHash) ? fromHash : buttons[0]!.dataset.tab!);
  }
</script>
