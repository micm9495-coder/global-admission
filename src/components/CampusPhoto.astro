---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { monogramSize } from '@/lib/text';

interface Props {
  id: string;
  name: string;
  country: string;
  /** Detail-page hero: larger image, loaded eagerly. */
  hero?: boolean;
}
const { id, name, country, hero = false } = Astro.props;

// Campus photos live in src/assets/campus/<university id>.jpg. Add a file there to give a university a photo.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/campus/*.jpg', { eager: true });
const photo = photos[`/src/assets/campus/${id}.jpg`]?.default;
---
<div class="photoBox" style={`--mono-size:${monogramSize(name)}px`}>
  {photo ? (
    <Image
      class="cover"
      src={photo}
      alt={`Кампус: ${name}`}
      widths={hero ? [640, 960, 1280] : [400, 640]}
      sizes={hero ? '(max-width: 980px) 100vw, 560px' : '(max-width: 640px) 100vw, 320px'}
      loading={hero ? 'eager' : 'lazy'}
    />
  ) : (
    <span class="mono" aria-hidden="true">{name}<small>{country}</small></span>
  )}
</div>
