---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';
import { monogramSize } from '@/lib/text';

interface Props {
  id: string;
  name: string;
  country: string;
  /** Detail-page hero: larger image, loaded eagerly, with the author and licence under it. */
  hero?: boolean;
}
const { id, name, country, hero = false } = Astro.props;

// Campus photos live in src/assets/campus/<university id>.jpg, credits in src/data/photos.json.
// scripts/install-campus-photo.mjs adds both at once.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/campus/*.jpg', { eager: true });
const photo = photos[`/src/assets/campus/${id}.jpg`]?.default;
const credit = photo && hero ? (await getEntry('photos', id))?.data : undefined;
---
<div class="photoBox" style={`--mono-size:${monogramSize(name)}px`}>
  {photo ? (
    <Image
      class="cover"
      src={photo}
      alt={`Кампус: ${name}`}
      widths={hero ? [640, 960, 1280] : [400, 640]}
      sizes={hero ? '(max-width: 980px) 100vw, 560px' : '(max-width: 640px) 100vw, 320px'}
      loading={hero ? 'eager' : 'lazy'}
    />
  ) : (
    <span class="mono" aria-hidden="true">{name}<small>{country}</small></span>
  )}
  {credit && (
    <p class="photo-credit">
      Фото: <a href={credit.source} target="_blank" rel="noopener">{credit.author}</a>,
      {credit.licenseUrl ? <a href={credit.licenseUrl} target="_blank" rel="noopener">{credit.license}</a> : credit.license}
    </p>
  )}
</div>

<style>
  .photo-credit {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 2;
    max-width: calc(100% - 16px);
    margin: 0;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .photo-credit a {
    color: inherit;
  }
</style>
