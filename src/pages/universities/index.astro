---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import UniversityCard from '@/components/UniversityCard.astro';
import { withBase } from '@/lib/links';

const universities = (await getCollection('universities')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Университеты мира" description="100 университетов мира: рейтинги QS, THE и U.S. News, города, сильные направления, стоимость и условия поступления." section="universities">
  <section>
    <div class="sect-head"><h1>Университеты мира</h1><span class="meta" id="uni-count">{universities.length} вузов · подборка, не рейтинг</span></div>
    <p class="notice">QS 2026, THE 2026 и U.S. News 2025–26. Показаны внесённые числовые позиции; специализированные рейтинги подписаны отдельно. При равных местах выводятся все вузы из каталога (например, Princeton и Sydney — № 25). <a href="https://www.topuniversities.com/world-university-rankings/2026">Источник QS</a> · <a href={withBase('photos/')}>Фотографии и лицензии</a></p>
    <div class="toolbar">
      <input id="uq" type="search" placeholder="Вуз, город, страна или место QS (#25)…" aria-label="Найти университет" />
      <select id="sort" aria-label="Сортировка">
        <option value="default">По умолчанию</option>
        <option value="qs">По QS 2026</option>
        <option value="top25">QS 2026: топ-25 мира</option>
        <option value="score">По моей оценке</option>
      </select>
    </div>
    <div class="grid" id="unigrid">
      {universities.map((u) => <UniversityCard university={u} />)}
      <div class="empty" id="uni-empty" hidden>
        <strong>Ничего не нашлось</strong>Попробуй название по-английски, страну («Швейцария») или место в QS («#25»).<br />
        <button type="button" class="ghost" id="uni-reset">Сбросить поиск</button>
      </div>
    </div>
  </section>
</Base>

<script>
  import { matchesUniversity } from '@/lib/search';
  import { average, loadRatings } from '@/lib/ratings';

  const input = document.querySelector<HTMLInputElement>('#uq')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const grid = document.querySelector<HTMLElement>('#unigrid')!;
  const empty = document.querySelector<HTMLElement>('#uni-empty')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.ucard')];
  const ratings = loadRatings();
  const qsOf = (c: HTMLElement) => (c.dataset.qs ? Number(c.dataset.qs) : null);
  const mine = (c: HTMLElement) => average(ratings[c.dataset.name ?? '']);

  for (const card of cards) {
    const score = mine(card);
    const slot = card.querySelector<HTMLElement>('[data-mine]');
    if (slot && score) {
      slot.textContent = `моя оценка ${score.toFixed(1)}`;
      slot.hidden = false;
    }
  }

  function apply() {
    const mode = sort.value;
    const ordered = [...cards].sort((a, b) => {
      if (mode === 'qs' || mode === 'top25') return (qsOf(a) ?? 99999) - (qsOf(b) ?? 99999);
      if (mode === 'score') return mine(b) - mine(a);
      return Number(a.dataset.order) - Number(b.dataset.order);
    });
    let shown = 0;
    for (const card of ordered) {
      const qs = qsOf(card);
      const ok = matchesUniversity(card.dataset.search ?? '', qs, input.value) && (mode !== 'top25' || (qs !== null && qs <= 25));
      card.hidden = !ok;
      if (ok) shown++;
      grid.insertBefore(card, empty);
    }
    empty.hidden = shown > 0;
    const url = new URL(location.href);
    input.value ? url.searchParams.set('q', input.value) : url.searchParams.delete('q');
    mode !== 'default' ? url.searchParams.set('sort', mode) : url.searchParams.delete('sort');
    history.replaceState(null, '', url);
  }

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  const wanted = params.get('sort');
  if (wanted && [...sort.options].some((o) => o.value === wanted)) sort.value = wanted;
  input.addEventListener('input', apply);
  sort.addEventListener('change', apply);
  document.querySelector('#uni-reset')!.addEventListener('click', () => {
    input.value = '';
    sort.value = 'default';
    apply();
  });
  apply();
</script>
